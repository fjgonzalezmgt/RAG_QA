# Copy this file to .env and replace mock values with local credentials.

# PostgreSQL / pgvector
DB_HOST=localhost
DB_PORT=5432
DB_NAME=RAG_DB
DB_USER=mock_user
DB_PASSWORD=mock_password
DB_SSLMODE=prefer
DB_EXTENSIONS_SCHEMA=extensions

# AI provider
# Use openai or lm_studio. The UI also lets you switch at runtime.
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-proj-replace-me
# Leave empty for OpenAI's default endpoint. If set, use a full URL such as https://api.openai.com/v1.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-5.2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Use 768 to share one pgvector schema with the default local Nomic model.
OPENAI_EMBEDDING_DIM=768
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_MAX_BATCH_CHARS=240000
OPENAI_TEMPERATURE=0.2
OPENAI_REASONING_EFFORT=medium
OPENAI_VERBOSITY=high
OPENAI_EMBEDDING_DOCUMENT_PREFIX=
OPENAI_EMBEDDING_QUERY_PREFIX=

# LM Studio local OpenAI-compatible server
# Start the LM Studio local server and load the chat and embedding models.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_CHAT_MODEL=nvidia/nemotron-3-nano-4b
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe
LM_STUDIO_EMBEDDING_DIM=768
# Prefixes are optional. Leave them unset to use model-aware defaults.
# LM_STUDIO_EMBEDDING_DOCUMENT_PREFIX=search_document:
# LM_STUDIO_EMBEDDING_QUERY_PREFIX=search_query:
# Avoid local embedding models that return more than 2000 dimensions in this
# PostgreSQL setup. For example, sfr-embedding-mistral returns 4096 dimensions
# and is not suitable for the shared OpenAI/local index.

# RAG
RAG_DOMAIN=quality_intelligence
RAG_PDF_DIR=./quality_knowledge_base
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=220
RAG_TOP_K=18
RAG_CANDIDATE_K=80
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_MAX_CONTEXT_CHARS=50000
RAG_RECURSIVE_PDF_SCAN=true
RAG_PDF_TEXT_FALLBACK=true
RAG_LLM_METADATA_ENRICHMENT=false
RAG_LLM_METADATA_MAX_CHARS=12000
